diff --git a/arch/arm64/configs/samsung/r9s.config b/arch/arm64/configs/samsung/r9s.config
index 2910d7325..0ff9ac96a 100644
--- a/arch/arm64/configs/samsung/r9s.config
+++ b/arch/arm64/configs/samsung/r9s.config
@@ -41,3 +41,23 @@ CONFIG_WLAIBSS=y
 # CONFIG_WLAN_BCM4375_ADVANCED_FEATURES is not set
 CONFIG_WLAN_SOFTAP_HE_ENABLE=y
 CONFIG_WL_RELMCAST=y
+
+# r9s-linux: namespaces and container plumbing.
+# /system/bin/linux-launch runs Debian under "unshare --pid --mount" and starts
+# Docker inside it; without these the launcher dies with "unshare: Invalid
+# argument" and the server never comes up. Mirrors r9s-linux/configs/docker.config
+# minus CONFIG_CFI_PERMISSIVE, which the device does not need.
+CONFIG_PID_NS=y
+CONFIG_IPC_NS=y
+CONFIG_USER_NS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NF_TABLES=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_NETDEV=y
+CONFIG_NFT_COMPAT=y
+CONFIG_MACVLAN=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_TMPFS_XATTR=y
