 // Draws the battery capacity on the screen. Should only be called with updateMutex locked.
+namespace {
+
+// r9s-linux: recovery has no iproute2 and no view of the lease, so the header can
+// only report what sysfs knows about the hub's Ethernet device.
+std::string EthernetStateText() {
+  std::unique_ptr<DIR, decltype(&closedir)> dir(opendir("/sys/class/net"), closedir);
+  if (!dir) return "";
+  while (dirent* entry = readdir(dir.get())) {
+    std::string name = entry->d_name;
+    if (name.rfind("eth", 0) != 0) continue;
+    std::string base = "/sys/class/net/" + name;
+    std::string state;
+    if (!android::base::ReadFileToString(base + "/operstate", &state)) continue;
+    if (android::base::Trim(state) != "up") return name + " down";
+    std::string speed;
+    if (!android::base::ReadFileToString(base + "/speed", &speed)) return name + " up";
+    int mbps = atoi(android::base::Trim(speed).c_str());
+    if (mbps >= 1000) return name + " 1G";
+    if (mbps > 0) return name + " " + std::to_string(mbps) + "M";
+    return name + " up";
+  }
+  return "";
+}
+
+// "Paused" is the charge guard holding at the ceiling: the charger is attached
+// but the kernel reports NOT_CHARGING, which is otherwise indistinguishable from
+// a full battery in this row.
+std::string ChargeStateText(aidl::android::hardware::health::BatteryStatus status) {
+  switch (status) {
+    case aidl::android::hardware::health::BatteryStatus::CHARGING:
+      return "Charging";
+    case aidl::android::hardware::health::BatteryStatus::NOT_CHARGING:
+      return "Paused";
+    case aidl::android::hardware::health::BatteryStatus::DISCHARGING:
+      return "Discharging";
+    case aidl::android::hardware::health::BatteryStatus::FULL:
+      return "Full";
+    default:
+      return "";
+  }
+}
+
+}  // namespace
