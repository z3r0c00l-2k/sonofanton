                       DRM_MODE_PAGE_FLIP_EVENT, &ongoing_flip) != 0) {
diff --git a/minui/graphics_drm.h b/minui/graphics_drm.h
index a8c9886..ee87667 100644
--- a/minui/graphics_drm.h
+++ b/minui/graphics_drm.h
@@ -79,4 +79,7 @@ class MinuiBackendDrm : public MinuiBackend {
 
   int drm_fd{ -1 };
   DrmConnector active_display = DRM_MAIN;
+  // While the CRTC is disabled a page flip would be rejected, so Flip() only
+  // rotates buffers and the next Blank(false) restores the newest one.
+  bool blanked_{ false };
 };
