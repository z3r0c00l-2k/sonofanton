diff --git a/kernel/cgroup/cpuset.c b/kernel/cgroup/cpuset.c
index 424123c..fe5f419 100644
--- a/kernel/cgroup/cpuset.c
+++ b/kernel/cgroup/cpuset.c
@@ -165,21 +165,6 @@ struct cpuset {
 	int child_ecpus_count;
 };
 
-/*
- * The vendor build limits the number of cpuset groups per boot.  cs_count is
- * never decremented (cpuset_css_free does not lower it), and every cgroup
- * created under a parent with cpuset enabled consumes one slot.  Recovery mode
- * plus a container host (Docker/buildkit create and destroy cgroups
- * continuously) exhausted the stock limit of 20 and then every mkdir failed
- * with -ENOMEM.  requested_cs[] is indexed by css->id - 1, so the array and the
- * limit must stay in lockstep; root css is id 1 and non-root ids start at 2.
- */
-#define CS_CGROUP_COUNT	256
-static struct cpuset requested_cs[CS_CGROUP_COUNT];
-static int cs_count;
-
-#define req_cs(cs)	(requested_cs[cs->css.id - 1])
-
 /*
  * Partition root states:
  *
@@ -2756,11 +2741,6 @@ cpuset_css_alloc(struct cgroup_subsys_state *parent_css)
 {
 	struct cpuset *cs;
 
-	if (++cs_count > CS_CGROUP_COUNT) {
-		pr_err("%s: too many cpuset groups(%d)\n", __func__, cs_count);
-		return ERR_PTR(-ENOMEM);
-	}
-
 	if (!parent_css)
 		return &top_cpuset.css;
 
@@ -2843,7 +2823,6 @@ static int cpuset_css_online(struct cgroup_subsys_state *css)
 	cpumask_copy(cs->cpus_allowed, parent->cpus_allowed);
 	cpumask_copy(cs->cpus_requested, parent->cpus_requested);
 	cpumask_copy(cs->effective_cpus, parent->cpus_allowed);
-	cpumask_copy(req_cs(cs).cpus_allowed, parent->cpus_allowed);
 	spin_unlock_irq(&callback_lock);
 out_unlock:
 	percpu_up_write(&cpuset_rwsem);
@@ -2954,13 +2933,6 @@ struct cgroup_subsys cpuset_cgrp_subsys = {
 
 int __init cpuset_init(void)
 {
-	int i;
-
-	for (i = 0; i < CS_CGROUP_COUNT; i++) {
-		BUG_ON(!alloc_cpumask_var(&requested_cs[i].cpus_allowed, GFP_KERNEL));
-		cpumask_setall(requested_cs[i].cpus_allowed);
-	}
-
 	BUG_ON(percpu_init_rwsem(&cpuset_rwsem));
 
 	BUG_ON(!alloc_cpumask_var(&top_cpuset.cpus_allowed, GFP_KERNEL));
