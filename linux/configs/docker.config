# r9s-linux: container and userspace delta
#
# Applied on top of the configuration recovered from the booting recovery
# Image (r9s-linux/baseline/kernel.config), never on top of a guessed
# defconfig. These options were verified absent from that baseline:
#
#   PID_NS IPC_NS USER_NS CGROUP_DEVICE CGROUP_PIDS BRIDGE_NETFILTER
#   NETFILTER_XT_MATCH_ADDRTYPE NFT NFT_COMPAT MACVLAN POSIX_MQUEUE TMPFS_XATTR
#
# Rationale: no container runtime starts without PID_NS; device and pids
# cgroups are required by the runtimes' sandbox setup; bridge NAT and the
# addrtype matcher are what docker's iptables rules use; the nft backend
# backs modern iptables; TMPFS_XATTR is what lets overlayfs use a tmpfs as
# an upper layer.

# Namespaces — a container runtime cannot start a container without these.
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# cgroup controllers the runtimes manage.
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# Bridge networking for docker/podman default networks.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# nftables backend (5.4 has no CONFIG_NFT symbol; the core is NF_TABLES and
# the xtables compatibility layer lives inside its Kconfig block).
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=y
CONFIG_MACVLAN=y

# Userspace assumptions.
CONFIG_POSIX_MQUEUE=y
CONFIG_TMPFS_XATTR=y

# --- build compatibility ---------------------------------------------------
# The baseline kernel was built with clang 21; this build uses clang 23, whose
# LTO omits the CFI jump-table entry for `init_module` in 30 of 272 modules.
# The indirect call from do_one_initcall then fails its type check and panics
# (observed on device: __cfi_check_fail in s3c2410_wdt, 5.9 s into boot).
# Permissive mode keeps the instrumentation, logs violations, and does not
# trap. Restore enforcement by rebuilding with a clang-21 toolchain.
CONFIG_CFI_PERMISSIVE=y
